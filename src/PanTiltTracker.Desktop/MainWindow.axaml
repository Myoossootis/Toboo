<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PanTiltTracker.Desktop.ViewModels" xmlns:views="using:PanTiltTracker.Desktop.Views"
        xmlns:icons="using:PanTiltTracker.Desktop.Controls" x:Class="PanTiltTracker.Desktop.MainWindow"
        x:DataType="vm:CompanionShellViewModel" Title="toboo · 桌面陪伴机器人"
        Width="1440" Height="900" MinWidth="900" MinHeight="680" Classes="product"
        ExtendClientAreaToDecorationsHint="True" ExtendClientAreaChromeHints="NoChrome" ExtendClientAreaTitleBarHeightHint="0"
        WindowStartupLocation="CenterScreen">
  <!-- Product hierarchy (§2.1/2.8): companion canvas first, perception second, diagnostics on demand.
       Existing teal tokens; spacing 4/8/12/16/24/32/48; type 12/14/16/20/24/32.
       Navigation is fixed-width (§3.4.1), icon-only at compact desktop widths. -->
  <Border BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1">
    <Grid x:Name="ShellGrid">
      <Grid.ColumnDefinitions><ColumnDefinition Width="208" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="72,*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="12" Margin="24,0" VerticalAlignment="Center">
            <icons:AppIcon Kind="Robot" Width="36" Height="36" StrokeThickness="2.2" />
            <TextBlock Text="toboo" Classes="navlabel" FontSize="32" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Grid.Row="1" Spacing="8" Margin="12,40,12,0">
            <Button x:Name="CompanionNav" Classes="navigation" Classes.selected="{Binding IsCompanionPage}" Command="{Binding NavigateCommand}" CommandParameter="0" ToolTip.Tip="陪伴">
              <StackPanel Orientation="Horizontal" Spacing="20"><icons:AppIcon Kind="Chat" /><TextBlock Text="陪伴" Classes="navlabel" /></StackPanel>
            </Button>
            <Button x:Name="DevicesNav" Classes="navigation" Classes.selected="{Binding IsDevicesPage}" Command="{Binding NavigateCommand}" CommandParameter="1" ToolTip.Tip="设备">
              <StackPanel Orientation="Horizontal" Spacing="20"><icons:AppIcon Kind="Robot" /><TextBlock Text="设备" Classes="navlabel" /></StackPanel>
            </Button>
            <Button x:Name="SettingsNav" Classes="navigation" Classes.selected="{Binding IsSettingsPage}" Command="{Binding NavigateCommand}" CommandParameter="2" ToolTip.Tip="设置">
              <StackPanel Orientation="Horizontal" Spacing="20"><icons:AppIcon Kind="Settings" /><TextBlock Text="设置" Classes="navlabel" /></StackPanel>
            </Button>
          </StackPanel>
          <StackPanel Grid.Row="2" Spacing="16" Margin="24">
            <TextBlock Text="{Binding RobotConnection}" Classes="caption navlabel" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource SubtleBrush}"><TextBlock Text="我" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
              <TextBlock Text="本地会话" Classes="caption navlabel" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Column="1" RowDefinitions="64,*">
        <Border BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16">
            <Border Background="Transparent" PointerPressed="DragWindow"><TextBlock Text="{Binding PageTitle}" FontSize="20" FontWeight="SemiBold" Margin="24,0" VerticalAlignment="Center" /></Border>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <Button x:Name="GlobalStopButton" Content="{Binding StopLabel}" Classes="quiet" Command="{Binding Tracking.StopCommand}" IsVisible="{Binding Tracking.IsRunning}" />
              <Button Content="设备管理" Classes="quiet" Command="{Binding NavigateCommand}" CommandParameter="1" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
              <Button Content="−" Classes="windowbutton" Click="Minimize" ToolTip.Tip="最小化" />
              <Button Content="□" Classes="windowbutton" Click="Maximize" ToolTip.Tip="最大化 / 还原" />
              <Button Content="×" Classes="windowbutton close" Click="CloseWindow" ToolTip.Tip="关闭" />
            </StackPanel>
          </Grid>
        </Border>
        <Grid Grid.Row="1" RowDefinitions="Auto,*">
          <StackPanel Spacing="8" Margin="24,12,24,0" IsVisible="{Binding HasNotice}">
            <Border Background="#FBEDE8" CornerRadius="8" Padding="12" IsVisible="{Binding Tracking.HasError}"><TextBlock Text="{Binding Tracking.ErrorMessage}" Foreground="#9A4331" TextWrapping="Wrap" /></Border>
            <Border Background="#FFF4D6" CornerRadius="8" Padding="12" IsVisible="{Binding Tracking.HasServoNotice}"><TextBlock Text="{Binding Tracking.ServoNotice}" Foreground="#805A16" TextWrapping="Wrap" /></Border>
          </StackPanel>
          <Grid Grid.Row="1">
            <views:CompanionHomeView x:Name="HomeView" IsVisible="{Binding IsCompanionPage}" />
            <views:DevicesView x:Name="DevicesView" IsVisible="{Binding IsDevicesPage}" />
            <views:PreferencesView x:Name="PreferencesView" IsVisible="{Binding IsSettingsPage}" />
          </Grid>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
