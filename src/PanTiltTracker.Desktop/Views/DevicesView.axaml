<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PanTiltTracker.Desktop.ViewModels" xmlns:icons="using:PanTiltTracker.Desktop.Controls"
             x:Class="PanTiltTracker.Desktop.Views.DevicesView" x:DataType="vm:CompanionShellViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="24" Margin="32,24">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <StackPanel Spacing="4"><TextBlock Text="我的设备" FontSize="32" FontWeight="SemiBold" /><TextBlock Text="连接与管理 toboo 的感知和表达" Classes="muted" TextWrapping="Wrap" /></StackPanel>
        <Button Grid.Column="1" Content="高级调试 →" Classes="textlink" Command="{Binding OpenAdvancedCommand}" VerticalAlignment="Center" />
      </Grid>
      <Grid ColumnDefinitions="1.3*,*" ColumnSpacing="16">
        <StackPanel Spacing="16">
          <Border Classes="shellcard">
            <StackPanel Spacing="16">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <icons:AppIcon Kind="Camera" /><TextBlock Grid.Column="1" Text="视觉" Classes="section" />
                <TextBlock Grid.Column="2" Text="{Binding Tracking.RunLabel}" Classes="caption" VerticalAlignment="Center" />
              </Grid>
              <Border Height="240" Background="{StaticResource SubtleBrush}" CornerRadius="12" ClipToBounds="True">
                <Grid>
                  <Image Source="{Binding Tracking.Preview}" Stretch="Uniform" IsVisible="{Binding Tracking.HasPreview}" />
                  <StackPanel Spacing="12" VerticalAlignment="Center" HorizontalAlignment="Center" IsVisible="{Binding !Tracking.HasPreview}">
                    <icons:AppIcon Kind="Camera" Width="40" Height="40" HorizontalAlignment="Center" />
                    <TextBlock Text="让 toboo 看见你的表情" FontSize="16" FontWeight="Medium" TextWrapping="Wrap" />
                    <TextBlock Text="开启预览不会转动云台" Classes="caption" HorizontalAlignment="Center" />
                  </StackPanel>
                </Grid>
              </Border>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <ComboBox x:Name="DeviceCameraSelector" ItemsSource="{Binding Tracking.Cameras}" SelectedItem="{Binding Tracking.SelectedCamera}" PlaceholderText="选择 USB 摄像头" IsEnabled="{Binding Tracking.CanConfigure}" />
                <Button Grid.Column="1" Content="刷新" Classes="quiet" Command="{Binding Tracking.RefreshCamerasCommand}" />
              </Grid>
              <TextBlock Text="{Binding CameraState}" Classes="caption" TextWrapping="Wrap" />
              <TextBlock Text="{Binding SourceCaption}" Classes="caption" IsVisible="{Binding Tracking.HasPreview}" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Button x:Name="StartVisionButton" Content="开启视觉感知" Classes="primary" Command="{Binding StartVisionCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsVisible="{Binding !Tracking.IsRunning}" />
                <Button x:Name="StopVisionButton" Content="停止感知" Classes="quiet" Command="{Binding Tracking.StopCommand}" IsVisible="{Binding Tracking.IsRunning}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                <Button Grid.Column="1" Content="图片 / 录像" Classes="textlink" Command="{Binding OpenAdvancedCommand}" />
              </Grid>
              <CheckBox x:Name="DeviceExpressionToggle" Content="本地表情识别" IsChecked="{Binding Tracking.ExpressionEnabled}" IsEnabled="{Binding Tracking.CanConfigure}" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Text="{Binding Tracking.ExpressionLabel}" FontWeight="Medium" TextWrapping="Wrap" />
                <Button Grid.Column="1" Content="详情 →" Classes="textlink" Command="{Binding OpenExpressionCommand}" />
              </Grid>
            </StackPanel>
          </Border>
          <Border Classes="shellcard">
            <StackPanel Spacing="16">
              <StackPanel Orientation="Horizontal" Spacing="12"><icons:AppIcon Kind="Mic" /><TextBlock Text="语音" Classes="section" /></StackPanel>
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"><icons:AppIcon Kind="Mic" Width="20" Height="20" /><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="语音输入" FontWeight="Medium" /><TextBlock Text="ICS43432 · 待接入" Classes="caption" /></StackPanel></Grid>
              <Border Height="1" Background="{StaticResource SurfaceBorderBrush}" />
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"><icons:AppIcon Kind="Volume" Width="20" Height="20" /><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="声音输出" FontWeight="Medium" /><TextBlock Text="语音合成与音响输出尚未接入" Classes="caption" TextWrapping="Wrap" /></StackPanel></Grid>
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="16">
          <Border Classes="shellcard">
            <StackPanel Spacing="16">
              <StackPanel Orientation="Horizontal" Spacing="12"><icons:AppIcon Kind="Robot" /><TextBlock Text="机器人" Classes="section" /></StackPanel>
              <Image Source="avares://toboo/Assets/toboo-companion.png" Height="144" RenderTransformOrigin="50%,50%"><Image.RenderTransform><ScaleTransform ScaleX="1.4" ScaleY="1.4" /></Image.RenderTransform></Image>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBlock Text="云台状态" Classes="muted" /><TextBlock Grid.Column="1" Text="{Binding RobotConnection}" FontWeight="Medium" /></Grid>
              <Border Height="1" Background="{StaticResource SurfaceBorderBrush}" />
              <TextBlock Text="云台控制" FontSize="16" FontWeight="SemiBold" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Button x:Name="DeviceHomeButton" Content="回到中心" Command="{Binding Tracking.Servo.HomeCommand}" IsEnabled="{Binding Tracking.Servo.CanCalibratedMotion}" Classes="quiet" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                <Button Grid.Column="1" Content="校准" Command="{Binding OpenCalibrationCommand}" Classes="quiet" />
              </Grid>
              <Button x:Name="DeviceFollowButton" Content="开启实物跟随" Command="{Binding Tracking.StartFollowCommand}" IsEnabled="{Binding CanFollow}" Classes="quiet" IsVisible="{Binding !Tracking.IsFollowing}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
              <Button Content="停止实物跟随" Command="{Binding Tracking.StopCommand}" Classes="quiet" IsVisible="{Binding Tracking.IsFollowing}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
              <TextBlock Text="{Binding FollowState}" FontWeight="Medium" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Tracking.Servo.FollowReadiness}" Classes="caption" TextWrapping="Wrap" />
              <Border Background="#FFF4D6" Padding="12" CornerRadius="8" IsVisible="{Binding Tracking.HasServoNotice}"><TextBlock Text="{Binding Tracking.ServoNotice}" Foreground="#805A16" TextWrapping="Wrap" /></Border>
            </StackPanel>
          </Border>
          <Border Classes="shellcard">
            <StackPanel Spacing="16">
              <TextBlock Text="表情屏幕" Classes="section" />
              <Border Background="#173D40" Padding="8" CornerRadius="8" HorizontalAlignment="Left">
                <Border Background="#134FBB" Padding="24,8" CornerRadius="4"><TextBlock Text="(^_^)&#10;toboo" FontFamily="Consolas" FontSize="20" Foreground="#E0EEFF" TextAlignment="Center" /></Border>
              </Border>
              <TextBlock Text="LCD 1602 · 待接入" FontWeight="Medium" /><TextBlock Text="颜文字效果示意，尚未发送到屏幕。" Classes="caption" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Button Content="传感器遥测 →" Command="{Binding OpenSensorsCommand}" Classes="quiet" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
        </StackPanel>
      </Grid>
      <Border Background="{StaticResource SubtleBrush}" CornerRadius="12" Padding="16">
        <StackPanel Spacing="8"><TextBlock Text="需要检查采集、接线或校准？" Classes="muted" /><Button Content="打开高级调试 →" Command="{Binding OpenAdvancedCommand}" Classes="textlink" HorizontalAlignment="Left" /></StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
