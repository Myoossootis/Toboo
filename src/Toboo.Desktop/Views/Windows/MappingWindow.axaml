<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Toboo.Desktop.Controls" x:Class="Toboo.Desktop.MappingWindow"
        Title="Toboo · 二维建图" Width="1050" Height="760" MinWidth="760" MinHeight="570"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WorkspaceBrush}">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24" Spacing="16">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <StackPanel Spacing="5">
          <TextBlock Text="二维建图" FontSize="27" FontWeight="SemiBold" />
          <TextBlock x:Name="DeviceStatus" Classes="caption" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button x:Name="DemoButton" Content="合成演示" Click="ShowDemo" Classes="quiet" />
          <Button x:Name="StartButton" Content="开启摄像头" Click="StartCamera" />
          <Button x:Name="StopButton" Content="停止" Click="StopCamera" IsEnabled="False" Classes="quiet" />
        </StackPanel>
      </Grid>
      <Border Classes="card" Padding="16" Background="{StaticResource SubtleBrush}">
        <StackPanel Spacing="6">
          <TextBlock x:Name="Advice" Text="等待采集" FontSize="20" FontWeight="SemiBold" />
          <TextBlock x:Name="RangeStatus" Text="距离 —" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <Grid ColumnDefinitions="2*,3*" ColumnSpacing="14">
        <Border Classes="card" Padding="14">
          <StackPanel Spacing="8">
            <TextBlock Text="摄像头" Classes="section" />
            <Border Height="260" Background="{StaticResource StageBrush}" CornerRadius="8" ClipToBounds="True">
              <Grid>
                <TextBlock x:Name="CameraPlaceholder" Text="摄像头未开启" Foreground="#CBDAD8"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Image x:Name="CameraPreview" Stretch="Uniform" />
              </Grid>
            </Border>
            <TextBlock x:Name="PoseStatus" Text="等待标定与 ArUco 7" TextWrapping="Wrap" Classes="caption" />
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Classes="card" Padding="14">
          <StackPanel Spacing="8">
            <TextBlock Text="俯视地图" Classes="section" />
            <controls:ObstacleMapView x:Name="Map" Height="300" />
            <TextBlock Text="青色轨迹 · 橙色回波 · 深色标记原点 · 底部标尺 1 m" TextWrapping="Wrap" Classes="caption" />
            <TextBlock x:Name="MapStatus" Text="0 次回波入图" TextWrapping="Wrap" Classes="caption" />
          </StackPanel>
        </Border>
      </Grid>
      <Expander x:Name="CalibrationOptions" Header="相机标定与安装参数">
        <Border Classes="card" Padding="14" Margin="0,8,0,0">
          <StackPanel Spacing="9">
            <TextBlock x:Name="CalibrationStatus" TextWrapping="Wrap" />
            <WrapPanel>
              <Button Content="保存棋盘格和标记" Click="SavePatterns" Classes="quiet" Margin="0,0,8,4" />
              <Button x:Name="SampleButton" Content="采集棋盘格画面" Click="SampleCalibration" IsEnabled="False" Classes="quiet" Margin="0,0,8,4" />
            </WrapPanel>
            <TextBlock Text="开启摄像头后，从不同位置和角度采集 12 张清晰的棋盘格。建图时把标记正向贴于竖直墙面。" Classes="caption" TextWrapping="Wrap" />
            <Grid x:Name="MountInputs" ColumnDefinitions="*,*,*,*,*" ColumnSpacing="9">
              <StackPanel Spacing="3"><TextBlock Text="标记黑边 (mm)" TextWrapping="Wrap" /><NumericUpDown x:Name="TagSize" Value="100" Minimum="40" Maximum="500" FormatString="0" /></StackPanel>
              <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="探头向右 (mm)" TextWrapping="Wrap" /><NumericUpDown x:Name="RightOffset" Value="0" Minimum="-300" Maximum="300" FormatString="0" /></StackPanel>
              <StackPanel Grid.Column="2" Spacing="3"><TextBlock Text="探头向下 (mm)" TextWrapping="Wrap" /><NumericUpDown x:Name="DownOffset" Value="0" Minimum="-300" Maximum="300" FormatString="0" /></StackPanel>
              <StackPanel Grid.Column="3" Spacing="3"><TextBlock Text="探头向前 (mm)" TextWrapping="Wrap" /><NumericUpDown x:Name="ForwardOffset" Value="0" Minimum="-300" Maximum="300" FormatString="0" /></StackPanel>
              <StackPanel Grid.Column="4" Spacing="3"><TextBlock Text="近障提示 (mm)" TextWrapping="Wrap" /><NumericUpDown x:Name="NearDistance" Value="350" Minimum="100" Maximum="1000" Increment="10" FormatString="0" /></StackPanel>
            </Grid>
            <TextBlock Text="探头与镜头同向固定。偏移从镜头中心量到探头中心，反方向填负值。" Classes="caption" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</Window>
