<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PanTiltTracker.Desktop.App"
             RequestedThemeVariant="Light">
  <!-- Existing light/teal palette, consolidated into semantic brushes (§1.5, §5.6).
       Spacing: 4/8/12/16/24/32; type: 12/14/16/20/24; two emphasis levels. -->
  <Application.Resources>
    <SolidColorBrush x:Key="WorkspaceBrush" Color="#F8F9F7" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="White" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#25332F" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#586B64" />
    <SolidColorBrush x:Key="AccentBrush" Color="#126F65" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#0C5C54" />
    <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#DFE7E8" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#D5DFE0" />
    <SolidColorBrush x:Key="SubtleBrush" Color="#EDF3F0" />
    <SolidColorBrush x:Key="StageBrush" Color="#1C333A" />
    <SolidColorBrush x:Key="StageTextBrush" Color="White" />
  </Application.Resources>
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#126F65" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="{StaticResource WorkspaceBrush}" />
    </Style>
    <!-- Product shell: hierarchy and group spacing (§2.1/3.6), one main action per surface (§2.8). -->
    <Style Selector="Window.product TextBlock">
      <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
    </Style>
    <Style Selector="Window.product"><Setter Property="FontSize" Value="16" /></Style>
    <Style Selector="Window.product TextBlock.caption"><Setter Property="FontSize" Value="14" /></Style>
    <Style Selector="Window.product Button:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SubtleBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBox.conversation">
      <Style.Resources>
        <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#586B64" />
      </Style.Resources>
    </Style>
    <Style Selector="Button.navigation">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="MinHeight" Value="56" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="FontSize" Value="20" />
    </Style>
    <Style Selector="Button.navigation.selected">
      <Setter Property="Background" Value="#DCE9E2" />
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Window.compact TextBlock.navlabel"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="Window.compact Button.navigation"><Setter Property="Padding" Value="16" /></Style>
    <Style Selector="Button.textlink">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
      <Setter Property="Padding" Value="0,4" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="Button.windowbutton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="64" />
      <Setter Property="FontSize" Value="20" />
    </Style>
    <Style Selector="Button.close:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="#FBEDE8" /></Style>
    <Style Selector="Button.round">
      <Setter Property="Width" Value="44" /><Setter Property="Height" Value="44" />
      <Setter Property="CornerRadius" Value="24" /><Setter Property="Padding" Value="10" />
    </Style>
    <Style Selector="Border.shellcard">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource SurfaceBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="24" />
    </Style>
    <Style Selector="Border.chatmessage"><Setter Property="Background" Value="{StaticResource SurfaceBrush}" /></Style>
    <Style Selector="Border.chatmessage.user"><Setter Property="Background" Value="{StaticResource SubtleBrush}" /></Style>
    <Style Selector="UserControl.compact Border.shellcard"><Setter Property="Padding" Value="16" /></Style>
    <Style Selector="TabControl.preferences"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="TabControl.preferences TabItem"><Setter Property="FontSize" Value="16" /><Setter Property="Padding" Value="16,12" /></Style>
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
    </Style>
    <Style Selector="Button.quiet">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.tertiary">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.metric">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource SurfaceBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinHeight" Value="36" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="NumericUpDown">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Slider">
      <Setter Property="Height" Value="32" />
      <Setter Property="MinHeight" Value="32" />
    </Style>
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style Selector="TabControl">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    </Style>
    <Style Selector="Expander">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="0" />
    </Style>
  </Application.Styles>
</Application>
