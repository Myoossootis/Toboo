<!-- Primary: one step and one next action. Secondary: readiness summary.
     Advanced parameters are disclosed on demand (§2.1/3.6); reuse existing light/teal tokens. -->
<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Toboo.Desktop.ViewModels" xmlns:views="using:Toboo.Desktop.Views"
             x:Class="Toboo.Desktop.Views.RobotCalibrationView" x:DataType="vm:CompanionShellViewModel">
  <Border Background="{StaticResource SurfaceBrush}" Padding="16">
    <StackPanel Spacing="16" IsEnabled="{Binding CanPrepareRobot}">
      <TextBlock Text="{Binding SetupStepLabel}" FontWeight="Medium" />
      <StackPanel IsVisible="{Binding SetupConnectionStep}" Spacing="8">
        <TextBlock Text="确认设备与供电" Classes="section" />
        <TextBlock Text="在上方选择 ESP32 并连接；确认 5V 已接、机构可动后，点击下一步。" TextWrapping="Wrap" Classes="caption" />
        <TextBlock Text="{Binding Tracking.Servo.Status}" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel IsVisible="{Binding SetupBoundsStep}" Spacing="8">
        <TextBlock Text="确认工作范围" Classes="section" />
        <TextBlock Text="{Binding Tracking.Servo.WorkingBoundsLabel}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Tracking.Servo.CenterLabel}" TextWrapping="Wrap" />
        <TextBlock Text="已验证的边界可直接复用。首次使用或更换舵机时，在下方高级设置中调整并保存。" Classes="caption" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel IsVisible="{Binding SetupDirectionStep}" Spacing="8">
        <TextBlock Text="确认跟随方向" Classes="section" />
        <ComboBox SelectedIndex="{Binding Tracking.FaceAim.PanDirectionIndex}" HorizontalAlignment="Stretch">
          <ComboBoxItem Content="目标在右侧 → S1 增大" /><ComboBoxItem Content="目标在右侧 → S1 减小" />
        </ComboBox>
        <ComboBox SelectedIndex="{Binding Tracking.FaceAim.TiltDirectionIndex}" HorizontalAlignment="Stretch">
          <ComboBoxItem Content="目标在下方 → S2 增大" /><ComboBoxItem Content="目标在下方 → S2 减小" />
        </ComboBox>
        <CheckBox Content="已通过微调检查方向" IsChecked="{Binding Tracking.FaceAim.DirectionsConfirmed}" />
        <TextBlock Text="{Binding SetupMessage}" Classes="caption" TextWrapping="Wrap" />
      </StackPanel>
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
        <Button Content="上一步" Command="{Binding PreviousSetupStepCommand}" Classes="quiet" />
        <Button Grid.Column="1" x:Name="SetupNextButton" Content="{Binding SetupNextLabel}" Command="{Binding AdvanceSetupCommand}" Classes="quiet" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
      </Grid>
      <Expander Header="高级设置" HorizontalAlignment="Stretch" Background="{StaticResource SurfaceBrush}">
        <Border Padding="8,16" Background="{StaticResource SurfaceBrush}"><views:RobotAdvancedSettingsView /></Border>
      </Expander>
    </StackPanel>
  </Border>
</UserControl>
