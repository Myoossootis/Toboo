<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Toboo.Desktop.ViewModels" xmlns:icons="using:Toboo.Desktop.Controls" xmlns:views="using:Toboo.Desktop.Views"
             x:Class="Toboo.Desktop.Views.DevicesView" x:DataType="vm:CompanionShellViewModel">
  <ScrollViewer x:Name="DeviceScroll" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="24" Margin="32,24">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <StackPanel Spacing="4"><TextBlock Text="我的设备" FontSize="32" FontWeight="SemiBold" /><TextBlock Text="连接与管理 toboo 的感知和表达" Classes="muted" TextWrapping="Wrap" /></StackPanel>
        <Button Grid.Column="1" Content="高级调试 →" Classes="textlink" Command="{Binding OpenAdvancedCommand}" VerticalAlignment="Center" />
      </Grid>
      <Grid ColumnDefinitions="1.3*,*" ColumnSpacing="16">
        <StackPanel Spacing="16">
          <Border Classes="shellcard">
            <StackPanel Spacing="16">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <icons:AppIcon Kind="Camera" /><TextBlock Grid.Column="1" Text="视觉" Classes="section" />
                <TextBlock Grid.Column="2" Text="{Binding Tracking.RunLabel}" Classes="caption" VerticalAlignment="Center" />
              </Grid>
              <Border Height="240" Background="{StaticResource SubtleBrush}" CornerRadius="12" ClipToBounds="True">
                <Grid>
                  <Image Source="{Binding Tracking.Preview}" Stretch="Uniform" IsVisible="{Binding Tracking.HasPreview}" />
                  <StackPanel Spacing="12" VerticalAlignment="Center" HorizontalAlignment="Center" IsVisible="{Binding !Tracking.HasPreview}">
                    <icons:AppIcon Kind="Camera" Width="40" Height="40" HorizontalAlignment="Center" />
                    <TextBlock Text="让 toboo 看见你的表情" FontSize="16" FontWeight="Medium" TextWrapping="Wrap" />
                    <TextBlock Text="开启预览不会转动云台" Classes="caption" HorizontalAlignment="Center" />
                  </StackPanel>
                </Grid>
              </Border>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <ComboBox x:Name="DeviceCameraSelector" ItemsSource="{Binding Tracking.Cameras}" SelectedItem="{Binding Tracking.SelectedCamera}" PlaceholderText="选择 USB 摄像头" IsEnabled="{Binding Tracking.CanConfigure}" />
                <Button Grid.Column="1" Content="刷新" Classes="quiet" Command="{Binding Tracking.RefreshCamerasCommand}" />
              </Grid>
              <TextBlock Text="{Binding CameraState}" Classes="caption" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Button x:Name="StartVisionButton" Content="开启视觉感知" Classes.primary="{Binding !CanFollow}" Classes.quiet="{Binding CanFollow}" Command="{Binding StartVisionCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsVisible="{Binding !Tracking.IsRunning}" />
                <Button x:Name="StopVisionButton" Content="{Binding StopLabel}" Classes="quiet" Command="{Binding Tracking.StopCommand}" IsVisible="{Binding Tracking.IsRunning}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                <Button Grid.Column="1" Content="图片 / 录像" Classes="textlink" Command="{Binding OpenAdvancedCommand}" />
              </Grid>
              <CheckBox x:Name="DeviceExpressionToggle" Content="本地表情识别" IsChecked="{Binding Tracking.ExpressionEnabled}" IsEnabled="{Binding Tracking.CanConfigure}" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Text="{Binding Tracking.ExpressionLabel}" FontWeight="Medium" TextWrapping="Wrap" />
                <Button Grid.Column="1" Content="详情 →" Classes="textlink" Command="{Binding OpenExpressionCommand}" />
              </Grid>
              <TextBlock Text="{Binding Tracking.ExpressionCandidate}" IsVisible="{Binding Tracking.HasExpressionCandidate}" Classes="caption" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border Classes="shellcard">
            <StackPanel Spacing="16">
              <StackPanel Orientation="Horizontal" Spacing="12"><icons:AppIcon Kind="Mic" /><TextBlock Text="语音" Classes="section" /></StackPanel>
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"><icons:AppIcon Kind="Mic" Width="20" Height="20" /><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="语音输入" FontWeight="Medium" /><TextBlock Text="{Binding Voice.InputDescription}" Classes="caption" TextWrapping="Wrap" /></StackPanel></Grid>
              <ComboBox x:Name="MicrophoneSourceSelector" SelectedIndex="{Binding Voice.MicrophoneSourceIndex}" IsEnabled="{Binding Voice.CanConfigureMicrophone}" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="电脑默认麦克风" /><ComboBoxItem Content="ICS43432 · ESP32-S3" />
              </ComboBox>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding Voice.IsI2sMicrophone}">
                <ComboBox x:Name="MicrophonePortSelector" ItemsSource="{Binding Voice.MicrophonePorts}" SelectedItem="{Binding Voice.MicrophonePort}" PlaceholderText="选择 ESP32-S3 串口" IsEnabled="{Binding Voice.CanConfigureMicrophone}" HorizontalAlignment="Stretch" />
                <Button Grid.Column="1" Content="刷新" Command="{Binding Voice.RefreshMicrophonePortsCommand}" Classes="quiet" IsEnabled="{Binding Voice.CanConfigureMicrophone}" />
              </Grid>
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" IsVisible="{Binding Voice.ShowInputMeter}"
                    ToolTip.Tip="{Binding Voice.InputMeterDetail}">
                <TextBlock Text="{Binding Voice.InputMeterLabel}" Classes="caption" VerticalAlignment="Center" />
                <ProgressBar x:Name="DeviceVoiceInputMeter" Grid.Column="1" Minimum="0" Maximum="100"
                             Value="{Binding Voice.InputMeterLevel}" Height="6" VerticalAlignment="Center"
                             Foreground="{StaticResource AccentBrush}" Background="{StaticResource ControlBorderBrush}"
                             AutomationProperties.Name="{Binding Voice.InputMeterLabel}"
                             AutomationProperties.HelpText="{Binding Voice.InputMeterDetail}" />
              </Grid>
              <Expander x:Name="ModuleRecognitionExpander" Header="语音识别与纠错" HorizontalAlignment="Stretch">
                <StackPanel Spacing="8" Margin="0,8,0,0">
                  <StackPanel Spacing="8" IsEnabled="{Binding Voice.CanConfigureMicrophone}">
                    <ComboBox x:Name="ModuleRecognizerSelector" SelectedIndex="{Binding Voice.ModuleRecognizerIndex}" IsVisible="{Binding Voice.IsI2sMicrophone}" HorizontalAlignment="Stretch">
                      <ComboBoxItem Content="本地 Whisper · 离线" />
                      <ComboBoxItem Content="DeepSeek ASR · 云端" />
                    </ComboBox>
                    <StackPanel IsVisible="{Binding Voice.IsI2sMicrophone}" Spacing="8">
                      <StackPanel IsVisible="{Binding Voice.IsCloudModule}" Spacing="8">
                        <CheckBox Content="识别后校正明显错字" IsChecked="{Binding Voice.CorrectTranscript}" />
                        <CheckBox Content="先核对文字（暂停自动语音命令）" IsChecked="{Binding Voice.ReviewTranscript}" />
                        <TextBlock Text="云端模式会将模块录音上传到 DeepSeek；纠错也使用 DeepSeek API，按服务计费。聊天仍使用 Harness。" Classes="caption" TextWrapping="Wrap" />
                      </StackPanel>
                    </StackPanel>
                    <TextBox x:Name="SpeechApiKeyBox" Text="{Binding Voice.ApiKeyDraft}" PasswordChar="●" Watermark="DeepSeek API Key（留空保留已保存密钥）" MaxLength="1024" />
                    <CheckBox Content="连续语音使用 DeepSeek 纠错" IsChecked="{Binding Voice.CorrectWakeTranscript}" />
                    <TextBlock Text="开启后，连续对话只上传转写文字用于纠错，使用此处的 API Key。"
                               Classes="caption" TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <Button Content="保存语音设置" Command="{Binding Voice.SaveRecognitionSettingsCommand}" Classes="quiet" />
                      <Button Grid.Column="1" Content="清除密钥" Command="{Binding Voice.ClearSpeechKeyCommand}" Classes="textlink" IsVisible="{Binding Voice.HasCloudKey}" />
                    </Grid>
                  </StackPanel>
                  <TextBlock Text="{Binding Voice.VoiceSettingsStatus}" Classes="caption" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Voice.AudioDiagnostics}" Classes="caption" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Voice.WakeCorrectionNotice}" IsVisible="{Binding Voice.HasWakeCorrectionNotice}"
                             Classes="caption" TextWrapping="Wrap" />
                  <StackPanel IsVisible="{Binding Voice.HasTranscript}" Spacing="6">
                    <TextBlock Text="识别原文" FontWeight="Medium" />
                    <SelectableTextBlock Text="{Binding Voice.OriginalTranscript}" TextWrapping="Wrap" />
                    <TextBlock Text="校正后文字" FontWeight="Medium" />
                    <SelectableTextBlock Text="{Binding Voice.CorrectedTranscript}" TextWrapping="Wrap" />
                  </StackPanel>
                </StackPanel>
              </Expander>
              <Border Height="1" Background="{StaticResource SurfaceBorderBrush}" />
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"><icons:AppIcon Kind="Volume" Width="20" Height="20" /><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="声音输出" FontWeight="Medium" /><TextBlock Text="{Binding Voice.OutputDescription}" Classes="caption" TextWrapping="Wrap" /></StackPanel></Grid>
              <Button Content="检查本机语音" Command="{Binding Voice.InitializeCommand}" Classes="quiet" HorizontalAlignment="Left" />
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="16">
          <Border Classes="shellcard">
            <StackPanel Spacing="16">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <icons:AppIcon Kind="Robot" /><TextBlock Grid.Column="1" Text="云台" Classes="section" />
                <TextBlock Grid.Column="2" Text="{Binding RobotConnection}" Classes="caption" VerticalAlignment="Center" />
              </Grid>
              <StackPanel DataContext="{Binding Tracking.Servo}" x:DataType="vm:ServoViewModel" Spacing="8">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                  <ComboBox x:Name="DeviceServoPortSelector" ItemsSource="{Binding AvailablePorts}" SelectedItem="{Binding Port, Mode=TwoWay}" PlaceholderText="选择 ESP32 串口" IsEnabled="{Binding !Busy}" HorizontalAlignment="Stretch" />
                  <Button Grid.Column="1" Content="刷新" Command="{Binding RefreshPortsCommand}" Classes="quiet" />
                  <Button x:Name="DeviceReadServoButton" Grid.Column="2" Content="连接" Command="{Binding InspectCommand}" IsEnabled="{Binding !Busy}" Classes="quiet" />
                </Grid>
                <TextBlock Text="{Binding Status}" Classes="caption" TextWrapping="Wrap" />
                <CheckBox Content="5V 已接，机构可动" IsChecked="{Binding Ready}" IsEnabled="{Binding !Busy}" />
              </StackPanel>
              <Button x:Name="DeviceHomeButton" Content="回到中心" Command="{Binding Tracking.Servo.HomeCommand}" IsEnabled="{Binding Tracking.Servo.CanCalibratedMotion}" Classes="quiet" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
              <Button x:Name="DeviceFollowButton" Content="{Binding FollowActionLabel}" Command="{Binding StartFollowCommand}" IsEnabled="{Binding CanFollow}" Classes="primary" IsVisible="{Binding !Tracking.IsFollowing}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
              <Button Content="停止实物跟随" Command="{Binding Tracking.StopCommand}" Classes="quiet" IsVisible="{Binding Tracking.IsFollowing}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
              <TextBlock Text="{Binding PreparationHint}" Classes="caption" TextWrapping="Wrap" />
              <StackPanel IsVisible="{Binding NeedsCameraModel}" Spacing="8">
                <TextBlock Text="相机快速配置" FontWeight="Medium" />
                <TextBlock Text="使用水平 60° / 垂直 45° 的通用估算。优先采用实际预览尺寸，否则按采集规格创建（默认 640×480）。可稍后在高级设置中校正。" Classes="caption" TextWrapping="Wrap" />
                <Button x:Name="QuickCameraSetupButton" Content="使用视场角估算并保存" Command="{Binding QuickConfigureCameraCommand}" Classes="quiet" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
              </StackPanel>
              <TextBlock Text="{Binding CameraSetupNotice}" IsVisible="{Binding HasCameraSetupNotice}" Classes="caption" TextWrapping="Wrap" />
              <Expander x:Name="RobotSetupExpander" Header="快速准备（首次使用）" IsExpanded="{Binding CalibrationExpanded, Mode=TwoWay}" HorizontalAlignment="Stretch" Background="{StaticResource SurfaceBrush}">
                <views:RobotCalibrationView />
              </Expander>
              <Border Background="#FFF4D6" Padding="12" CornerRadius="8" IsVisible="{Binding Tracking.HasServoNotice}"><TextBlock Text="{Binding Tracking.ServoNotice}" Foreground="#805A16" TextWrapping="Wrap" /></Border>
            </StackPanel>
          </Border>
          <Border Classes="shellcard">
            <StackPanel Spacing="16">
              <TextBlock Text="表情屏幕" Classes="section" />
              <Border Background="#173D40" Padding="8" CornerRadius="8" HorizontalAlignment="Left">
                <Border Background="#134FBB" Padding="8,4,8,8" CornerRadius="4">
                  <StackPanel Width="138">
                    <icons:LcdFacePreview x:Name="LcdPreview" Role="{Binding Tracking.Lcd.PreviewRole}" Height="44" />
                    <TextBlock Text="{Binding Tracking.Lcd.PreviewLabel}" Foreground="#E0EEFF" TextAlignment="Center" />
                  </StackPanel>
                </Border>
              </Border>
              <TextBlock Text="{Binding Tracking.Lcd.Status}" FontWeight="Medium" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <ComboBox x:Name="LcdPortSelector" ItemsSource="{Binding Tracking.Lcd.AvailablePorts}" SelectedItem="{Binding Tracking.Lcd.Port, Mode=TwoWay}"
                          PlaceholderText="选择 Uno 串口" HorizontalAlignment="Stretch" IsEnabled="{Binding Tracking.Lcd.CanConnect}" />
                <Button x:Name="RefreshLcdPortsButton" Grid.Column="1" Content="刷新" Command="{Binding Tracking.Lcd.RefreshPortsCommand}" Classes="quiet" />
              </Grid>
              <TextBlock Text="{Binding Tracking.Lcd.PortsHint}" Classes="caption" TextWrapping="Wrap" />
              <Button x:Name="ConnectLcdButton" Content="连接表情屏" Command="{Binding Tracking.Lcd.ConnectCommand}" Classes="quiet" IsVisible="{Binding !Tracking.Lcd.IsConnected}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
              <Button Content="断开表情屏" Command="{Binding Tracking.Lcd.DisconnectCommand}" Classes="quiet" IsVisible="{Binding Tracking.Lcd.CanDisconnect}" />
              <TextBlock Text="动画可在电脑上预览，连接支持动画的 Uno 后同步到实体屏。" Classes="caption" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Button Content="传感器遥测 →" Command="{Binding OpenSensorsCommand}" Classes="quiet" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
        </StackPanel>
      </Grid>
      <Border Background="{StaticResource SubtleBrush}" CornerRadius="12" Padding="16">
        <StackPanel Spacing="8"><TextBlock Text="需要检查采集、接线或校准？" Classes="muted" /><Button Content="打开高级调试 →" Command="{Binding OpenAdvancedCommand}" Classes="textlink" HorizontalAlignment="Left" /></StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
