<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Toboo.Desktop.ViewModels" xmlns:icons="using:Toboo.Desktop.Controls"
             x:Class="Toboo.Desktop.Views.CompanionHomeView" x:DataType="vm:CompanionShellViewModel">
  <UserControl.Styles>
    <Style Selector="Border.composer">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="22" />
      <Setter Property="BoxShadow" Value="0 3 12 0 #1025332F" />
    </Style>
    <Style Selector="Border.composer.capturing">
      <Setter Property="Background" Value="#F2F8F5" />
      <Setter Property="BorderBrush" Value="#BED9CE" />
      <Setter Property="CornerRadius" Value="28" />
    </Style>
    <Style Selector="Button.composerIcon">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="{StaticResource SubtleBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.composerIcon.captureStop">
      <Setter Property="Background" Value="#DBEEE5" />
    </Style>
    <Style Selector="Button.composerIcon.composerSend">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="{StaticResource SurfaceBrush}" />
    </Style>
    <Style Selector="Button.composerIcon.composerSend:disabled">
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Button.composerIcon:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#DBEEE5" />
    </Style>
    <Style Selector="Button.composerIcon.composerSend:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
    </Style>
  </UserControl.Styles>
  <Grid x:Name="HomeGrid">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="320" /></Grid.ColumnDefinitions>
    <Grid RowDefinitions="*,Auto" Margin="32,24,32,24">
      <ScrollViewer x:Name="ConversationScroll" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="24" Margin="0,24,0,24">
          <Grid ColumnDefinitions="144,*" ColumnSpacing="24" MinHeight="200" IsVisible="{Binding !Chat.HasMessages}">
            <Image Source="avares://toboo/Assets/toboo-companion.png" Width="144" Height="176" RenderTransformOrigin="50%,50%"><Image.RenderTransform><ScaleTransform ScaleX="1.4" ScaleY="1.4" /></Image.RenderTransform></Image>
            <StackPanel Grid.Column="1" Spacing="16" VerticalAlignment="Center">
              <TextBlock Text="今天，想聊点什么？" FontSize="32" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="我在这里，听你说。" FontSize="20" Classes="muted" />
            </StackPanel>
          </Grid>
          <Border Background="{StaticResource SubtleBrush}" CornerRadius="16" Padding="24" MaxWidth="560" HorizontalAlignment="Left" IsVisible="{Binding !Chat.IsConnected}">
            <StackPanel Spacing="12">
              <TextBlock Text="先认识一下彼此" FontSize="16" FontWeight="SemiBold" />
              <TextBlock Text="连接 DeepSeek Harness，开始属于你的陪伴对话。" Classes="muted" TextWrapping="Wrap" LineHeight="24" />
              <TextBlock Text="你可以选择附带有效表情线索，摄像头画面留在本机。" Classes="caption" TextWrapping="Wrap" />
              <Button Content="连接 Harness →" Command="{Binding Chat.ConnectCommand}" Classes="textlink" HorizontalAlignment="Left" />
            </StackPanel>
          </Border>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="{Binding Chat.HasMessages}">
            <TextBlock Text="{Binding Chat.SessionTitle}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="新对话" Command="{Binding Chat.NewChatCommand}" Classes="quiet" />
          </Grid>
          <Button Content="加载更早消息" Command="{Binding Chat.LoadOlderCommand}" Classes="textlink" IsVisible="{Binding Chat.HasMore}" HorizontalAlignment="Center" />
          <ItemsControl ItemsSource="{Binding Chat.Messages}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ChatMessageItem">
                <Border Classes="chatmessage" Classes.user="{Binding IsUser}" Padding="20,16" Margin="0,0,0,16" CornerRadius="16">
                  <StackPanel Spacing="8">
                    <TextBlock Text="{Binding Author}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" FontSize="14" />
                    <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="16" LineHeight="26" />
                    <TextBlock Text="{Binding Status}" Classes="caption" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
      <StackPanel Grid.Row="1" Spacing="12">
        <Border Background="#FFF4D6" Padding="12" CornerRadius="8" IsVisible="{Binding Chat.HasError}"><TextBlock Text="{Binding Chat.Error}" Foreground="#805A16" TextWrapping="Wrap" FontSize="14" /></Border>
        <StackPanel Orientation="Horizontal" Spacing="16">
          <Button Content="重新连接" Command="{Binding Chat.ConnectCommand}" Classes="textlink" />
          <Button Content="重试原请求" Command="{Binding Chat.RetryCommand}" IsVisible="{Binding Chat.HasPending}" Classes="textlink" />
          <Button x:Name="StopChatButton" Content="停止回复" Command="{Binding Chat.StopCommand}" IsVisible="{Binding Chat.CanStop}" Classes="quiet" />
        </StackPanel>
        <Border Classes="composer" Classes.capturing="{Binding Chat.VoiceInputActive}" Padding="12,8">
          <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <TextBox x:Name="ConversationInput" Grid.ColumnSpan="2" Classes="conversation"
                     IsVisible="{Binding !Chat.VoiceInputActive}" IsEnabled="{Binding Chat.CanEditDraft}"
                     Text="{Binding Chat.Draft}" Watermark="说说你此刻的想法…"
                     MaxLength="4000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" MaxHeight="132"
                     KeyDown="ComposerKeyDown" BorderThickness="0" Background="Transparent" Padding="4,8" FontSize="16" />
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"
                        IsVisible="{Binding !Chat.VoiceInputActive}">
              <Button x:Name="VoiceWakeButton" Content="{Binding Voice.WakeButtonLabel}" Command="{Binding Voice.ToggleWakeCommand}"
                      ToolTip.Tip="{Binding Voice.WakeHint}" Background="{StaticResource SubtleBrush}" BorderThickness="0"
                      MinHeight="30" Padding="10,5" CornerRadius="15" FontSize="13" />
              <ProgressBar x:Name="VoiceStandbyMeter" Width="58" Height="3" VerticalAlignment="Center"
                           Minimum="0" Maximum="100" Value="{Binding Voice.InputMeterLevel}" IsVisible="{Binding Voice.ShowWakeMeter}"
                           Foreground="{StaticResource AccentBrush}" Background="{StaticResource ControlBorderBrush}"
                           ToolTip.Tip="{Binding Voice.InputMeterDetail}" AutomationProperties.Name="语音会话麦克风音量" />
            </StackPanel>
            <Grid x:Name="ComposerVoiceStrip" Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="10"
                  IsVisible="{Binding Chat.VoiceInputActive}">
              <Button x:Name="ComposerVoiceCancelButton" Classes="composerIcon" Click="CancelComposerVoice"
                      ToolTip.Tip="取消语音 · Esc" AutomationProperties.Name="取消语音">
                <icons:AppIcon Kind="Cancel" Width="14" Height="14" />
              </Button>
              <icons:InputWaveform x:Name="ComposerWaveform" Grid.Column="1" Height="26" VerticalAlignment="Center"
                                   Level="{Binding Voice.InputMeterLevel}" IsActive="{Binding Voice.ShowComposerWaveform}"
                                   PulseBrush="{StaticResource AccentBrush}" TrackBrush="{StaticResource ControlBorderBrush}"
                                   ToolTip.Tip="{Binding Voice.InputMeterDetail}" AutomationProperties.Name="麦克风波形" />
            </Grid>
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <Button x:Name="VoiceHoldButton" Classes="composerIcon" Classes.captureStop="{Binding Chat.VoiceInputActive}"
                      IsVisible="{Binding Voice.ShowComposerMic}" IsEnabled="{Binding Voice.CanUseRecordButton}"
                      ToolTip.Tip="{Binding Voice.RecordHint}" AutomationProperties.Name="{Binding Voice.RecordLabel}">
                <Panel>
                  <icons:AppIcon Kind="Mic" Width="15" Height="18" IsVisible="{Binding !Chat.VoiceInputActive}" />
                  <icons:AppIcon Kind="StopCapture" Width="13" Height="13" Fill="{StaticResource AccentBrush}"
                                 IsVisible="{Binding Chat.VoiceInputActive}" />
                </Panel>
              </Button>
              <Button x:Name="SendChatButton" Classes="composerIcon composerSend" Command="{Binding Chat.SendCommand}"
                      ToolTip.Tip="发送 · Enter（Shift+Enter 换行）" AutomationProperties.Name="发送">
                <icons:AppIcon Kind="SendUp" Stroke="{Binding $parent[Button].Foreground}" Width="16" Height="16" />
              </Button>
            </StackPanel>
          </Grid>
        </Border>
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="8,0">
          <CheckBox Content="朗读回复" IsChecked="{Binding Chat.ReadReplies}" IsEnabled="{Binding Voice.CanSpeak}"
                    FontSize="13" MinHeight="28" />
          <TextBlock Grid.Column="1" Text="{Binding Chat.ConnectionStatus}" Classes="caption"
                     HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{Binding Chat.PrivacyHint}" />
          <Panel Grid.Column="2" IsVisible="{Binding !Chat.VoiceInputActive}">
            <Button x:Name="StopVoiceButton" Content="停止语音" Command="{Binding Voice.StopCommand}" IsVisible="{Binding Voice.CanStop}"
                    Classes="quiet" MinHeight="30" Padding="8,4" FontSize="13" />
          </Panel>
        </Grid>
        <TextBlock x:Name="VoiceActivityText" Text="{Binding Voice.VoiceActivityMessage}" Margin="8,0"
                   Classes="caption" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}"
                   TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        <TextBlock Text="{Binding Voice.WakeCorrectionNotice}" IsVisible="{Binding Voice.HasWakeCorrectionNotice}"
                   Margin="8,0" Classes="caption" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
      </StackPanel>
    </Grid>
    <Border Grid.Column="1" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1,0,0,0">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="24" Margin="24,32">
          <TextBlock Text="此刻的 toboo" FontSize="20" FontWeight="SemiBold" />
          <StackPanel Spacing="8">
            <Border Background="#134FBB" CornerRadius="14" Width="176" Height="78" HorizontalAlignment="Center">
              <icons:LcdFacePreview Role="{Binding Tracking.Lcd.PreviewRole}" Width="168" Height="52" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="{Binding Tracking.Lcd.PreviewLabel}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding RobotDetail}" Classes="muted" HorizontalAlignment="Center" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Spacing="12" IsVisible="{Binding ShowVisualPanel}">
            <Border Height="1" Background="{StaticResource SurfaceBorderBrush}" />
            <TextBlock Text="视觉感知" FontSize="16" FontWeight="SemiBold" />
            <Border Height="160" CornerRadius="12" ClipToBounds="True" Background="{StaticResource SubtleBrush}">
              <Grid>
                <Image Source="{Binding Tracking.Preview}" Stretch="Uniform" IsVisible="{Binding Tracking.HasPreview}" />
                <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !Tracking.HasPreview}">
                  <icons:AppIcon Kind="Camera" Width="32" Height="32" HorizontalAlignment="Center" />
                  <TextBlock Text="摄像头尚未开启" Classes="caption" />
                </StackPanel>
              </Grid>
            </Border>
            <TextBlock Text="{Binding SourceCaption}" Classes="caption" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Tracking.ExpressionLabel}" TextWrapping="Wrap" FontWeight="Medium" />
            <TextBlock Text="表情仅作为互动线索" Classes="caption" />
            <Button Content="管理视觉设备 →" Command="{Binding NavigateCommand}" CommandParameter="1" Classes="textlink" HorizontalAlignment="Left" />
          </StackPanel>
          <Border Height="1" Background="{StaticResource SurfaceBorderBrush}" />
          <TextBlock Text="{Binding Voice.InputDescription}" Classes="caption" TextWrapping="Wrap" />
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
